# =============================================================================
# Google Cloud / Vertex AI (required for batch predictions)
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# OR use a Gemini API key instead of Vertex AI (simpler, no GCP project needed):
# GOOGLE_API_KEY=your-gemini-api-key

# =============================================================================
# GCS Bucket (required for batch predictions with images)
# =============================================================================
# Create a bucket: gsutil mb -l us-central1 gs://your-bucket-name
GCS_BUCKET_NAME=your-bucket-name
GCS_BUCKET_PREFIX=agentic-media-perf

# =============================================================================
# Models (optional, defaults shown)
# =============================================================================
# AGENT_LLM_MODEL=gemini-3-pro-preview
# CAPTION_LLM_MODEL=gemini-2.5-flash

# =============================================================================
# Dataset Paths (optional, defaults to data/ relative to project root)
# =============================================================================
# RAW_DATASET_PATH=data/raw
# INFLUENCER_DATASET_PATH=data/users_influencers_SPOD
